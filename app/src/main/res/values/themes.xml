<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Aura is dark-only. The window background matches the app background (#121212),
      so there is no white flash before Compose draws the first frame.
    -->
    <style name="Theme.Notebook" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/aura_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
