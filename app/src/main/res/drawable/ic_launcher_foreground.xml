<?xml version="1.0" encoding="utf-8"?>
<!--
  Aura app icon: a geometric letter "A" drawn with the accent gradient (blue to violet)
  and a soft glow behind it. Everything stays inside the 66 dp safe zone of the adaptive icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Soft glow -->
    <path android:pathData="M54,54m-30,0a30,30 0,1 1,60 0a30,30 0,1 1,-60 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="56"
                android:gradientRadius="30">
                <item android:offset="0" android:color="#559B6BFF" />
                <item android:offset="1" android:color="#009B6BFF" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- The "A" -->
    <path
        android:pathData="M38,76 L54,32 L70,76 M43.5,61 L64.5,61"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="38"
                android:startY="32"
                android:endX="70"
                android:endY="76">
                <item android:offset="0" android:color="#FF5B7CFF" />
                <item android:offset="1" android:color="#FF9B6BFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
