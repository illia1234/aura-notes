<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Auto Backup for Android 11 and older (Android 12+ uses data_extraction_rules.xml).
  The system copies these files to the user's Google account backup automatically;
  the app itself needs no network or account code.
  Backed up: the notes database and the settings file.
-->
<full-backup-content>
    <include domain="database" path="notebook.db" />
    <include domain="database" path="notebook.db-wal" />
    <include domain="file" path="datastore/settings.preferences_pb" />
</full-backup-content>
