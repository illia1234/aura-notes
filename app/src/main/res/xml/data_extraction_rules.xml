<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: what goes into the cloud backup and what moves to a new phone
  during device-to-device transfer. Same files as backup_rules.xml.
  notebook.db-wal holds Room's most recent changes, so it is included too
  (the -shm file is only a cache and is rebuilt automatically).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="notebook.db" />
        <include domain="database" path="notebook.db-wal" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="notebook.db" />
        <include domain="database" path="notebook.db-wal" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
